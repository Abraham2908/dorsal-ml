# Copy to .env and export as needed:
#   set -a; source .env; set +a

# Runtime
PYTHON_BIN=.venv/bin/python
DATA_DIR=./data
MODELS_DIR=./models
REPORTS_DIR=./reports
LOG_DIR=./logs

# Layer 1 dataset/training
NORMAL_COUNT=100000
ATTACK_RATIO=0.2
MAX_PER_CATEGORY=5000
N_ESTIMATORS=300
MAX_DEPTH=20
TEST_SIZE=0.2
MIN_PRECISION=0.92
MIN_RECALL=0.85
MAX_FPR=0.03
MAX_LATENCY_P99_MS=2.0
BENCHMARK_ITERATIONS=10000
TARGET_APP=unknown
LAB_RUN_ID=
IS_REPLAY=0
DATASET_MANIFEST_PATH=
HARD_NEGATIVES_PATH=
HARD_NEGATIVE_RATIO=0.0
SCENARIO_PROFILE=default
SLICE_MIN_SUPPORT=20
SLICE_GATES_CONFIG=
VALIDATION_REPORT=
PROMOTION_REPORT=

# Layer 1 real-world workflow (make layer1-realworld)
TRAIN_ATTACK_RATIO=0.20
TRAIN_NORMAL_COUNT=0
REALWORLD_ATTACK_RATIO=0.02
REALWORLD_NORMAL_COUNT=0
REALWORLD_MIN_PRECISION=0.85
REALWORLD_MIN_RECALL=0.80
REALWORLD_MAX_FPR=0.01
REALWORLD_MAX_LATENCY_P99_MS=2.0
REALWORLD_ITERATIONS=10000
TRAIN_DATASET_MANIFEST=
REALWORLD_DATASET_MANIFEST=
TRAIN_VALIDATION_REPORT=
REALWORLD_VALIDATION_REPORT=
TRAIN_LAB_RUN_ID=
REALWORLD_LAB_RUN_ID=
TRAIN_IS_REPLAY=
REALWORLD_IS_REPLAY=

# Optional local snapshot files
BURP_FILE=
ZAP_FILE=
ACUNETIX_FILE=
STRIX_RUNS_DIR=
SHANNON_SESSIONS_DIR=

# Layer 3 telemetry/anomaly
CLICKHOUSE_HOST=clickhouse.dorsal.internal
TELEMETRY_DAYS=14
TELEMETRY_INPUT=
ANOMALY_CONTAMINATION=0.01
ANOMALY_ESTIMATORS=200
ANOMALY_MAX_FPR=0.03

# Optional secure bundle packaging
DORSAL_MODEL_SIGNING_PRIVATE_KEY=
DORSAL_MODEL_KEK=
MIN_GATEWAY_VERSION=0.1.0

# Weekly mode toggles
ENABLE_LAYER1=1
ENABLE_LAYER3=1
ENABLE_GATEWAY_BUILD=0
GATEWAY_DIR=../gateway
DOCKER_REGISTRY=ghcr.io/sharkzone/dorsal
