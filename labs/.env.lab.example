# Control plane URL (outside this compose)
DORSAL_CONTROL_URL=http://host.docker.internal:8000
# Local path to Dorsal gateway source used for image build
# Relative to labs/docker-compose.layer1-lab.yml
DORSAL_GATEWAY_BUILD_CONTEXT=../../dorsal/gateway

# Workspace provisioning token — all lab gateways auto-register using this.
# Create once: POST /api/v1/workspaces/{id}/provision-tokens  (admin token required)
# Format: wsp_xxxxxxxxxxxxxxxx
DORSAL_PROVISION_TOKEN=wsp_replace_me

# Optional bearer token for org-level metrics snapshot in attack agent
DORSAL_TEST_ORG_TOKEN=

# Runtime defaults for pilot-safe execution
DORSAL_TENANT_HASH=tenant_lab
DORSAL_ENFORCEMENT_MODE=detect
DORSAL_ML_ROLLOUT_MODE=shadow
DORSAL_ML_ROLLOUT_PERCENT=20
DORSAL_ML_ALERT_THRESHOLD=0.55
DORSAL_ML_BLOCK_THRESHOLD=0.85
DORSAL_ML_ANOMALY_WEIGHT=0.30
DORSAL_SYNC_INTERVAL_SECONDS=30

# GraphQL lab
HASURA_GRAPHQL_ADMIN_SECRET=lab_hasura_admin
VAMPI_VULNERABLE=1
VAMPI_TOKEN_TTL=60

# Legit traffic simulator
USER_SIM_DURATION_MINUTES=45
USER_SIM_RPS=3
USER_SIM_CONCURRENCY=12

# Attack runner
ATTACK_ITERATIONS=4

# Optional LLM payload expansion
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
