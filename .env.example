# Control Plane URL (Cloudflare Tunnel on VPS)
CONTROL_PLANE_URL=https://dorsal-api.sharkzone.com.br
CONTROL_PLANE_ADMIN_EMAIL=root@dorsal.local
CONTROL_PLANE_ADMIN_PASSWORD=changeme

# Shared secret — generate with: openssl rand -hex 32
DORSAL_ML_API_KEY=

# Tunnel token for the GPU machine (created in Cloudflare Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN_ML=

# Training mode: static | dynamic | all
TRAIN_MODE=all
